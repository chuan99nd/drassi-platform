# Copy to .env and edit as needed. .env is gitignored; this file (.env.example) is committed
# and must never contain real secrets — placeholders only.

# ---- drassi-server (platform) — see T-M0-02, T-M0-05 -----------------------------------------
DRASSI_HTTP_ADDR=:8080
DRASSI_GRPC_ADDR=:9090
DRASSI_DB_DSN=postgres://drassi:drassi@localhost:5432/drassi?sslmode=disable
DRASSI_HEARTBEAT_INTERVAL_SECONDS=10
DRASSI_HEARTBEAT_MISS_LIMIT=3

# ---- drassi-runner — see T-M0-03, T-M0-06 -----------------------------------------------------
DRASSI_SERVER_ADDR=localhost:9090
DRASSI_RUNNER_NAME=dev-runner-1
DRASSI_RUNNER_LABELS=self-hosted,linux
DRASSI_RUNNER_CAPACITY=1
DRASSI_RUNNER_VERSION=dev

# ---- GitHub integration (used from M1/M2 — webhook + status API + private repo clone) --------
# Plain GITHUB_TOKEN is the name used by the M0-08 task doc; DRASSI_GITHUB_TOKEN is kept as an
# alias for consistency with the DRASSI_* config convention once the GitHub integration task
# lands. Leave both empty here — never commit a real token.
GITHUB_TOKEN=
DRASSI_GITHUB_TOKEN=

# ---- Postgres (consumed by docker-compose.yml + DRASSI_DB_DSN/DATABASE_URL above) -------------
POSTGRES_USER=drassi
POSTGRES_PASSWORD=drassi
POSTGRES_DB=drassi

# DATABASE_URL — canonical value, must match DRASSI_DB_DSN default (used by `migrate` CLI via
# the Makefile `migrate-up`/`migrate-down` targets).
DATABASE_URL=postgres://drassi:drassi@localhost:5432/drassi?sslmode=disable

# ---- MinIO (provisioned now for M5 artifacts/cache; not consumed until then) ------------------
MINIO_ROOT_USER=drassi
MINIO_ROOT_PASSWORD=drassi123
MINIO_API_ADDR=localhost:9000
MINIO_CONSOLE_ADDR=localhost:9001

# ---- Webhooks (M2) ------------------------------------------------------------
# GitHub webhook (T-M2-01/02/03)
DRASSI_GH_WEBHOOK_SECRET=            # HMAC secret configured on the GitHub webhook
DRASSI_GH_ALLOWED_REPO=              # only this owner/name may trigger runs (host-mode: no forks)
# GitLab webhook (T-M2-04) — supply a real GitLab host before enabling
DRASSI_GITLAB_BASE_URL=              # e.g. https://gitlab.example.com (instance root, no /api/v4)
DRASSI_GITLAB_TOKEN=                 # PRIVATE-TOKEN for fetching workflow files + cloning
DRASSI_GITLAB_WEBHOOK_SECRET=        # expected X-Gitlab-Token value
DRASSI_GITLAB_ALLOWED_PROJECT=       # only this path_with_namespace may trigger runs
DRASSI_GITLAB_WORKFLOW_PATH=         # optional: single .github/workflows/<file>.yml to plan
